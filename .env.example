# GDPTraders root environment — loaded by docker-compose.yml (env_file: .env)
# Copy this file to `.env` at the PROJECT ROOT (c:\...\gdpTraders\.env) before
# running `docker compose up`. Without it, Docker Compose refuses to start with
# "env file ...\.env not found".
#
# NOTE: PORT, NODE_ENV, USE_IN_MEMORY_DB and DATABASE_URL are also set inside
# docker-compose.yml's `environment:` block for the backend (that takes
# precedence over this file). Values here provide the secrets referenced by
# the backend but not by the compose file.

# --- Authentication / JWT ---
JWT_SECRET=gdptraders_dev_secret_change_me_in_production
JWT_EXPIRES_IN=1h

# URL used for links inside verification / email templates
FRONTEND_URL=http://localhost:3000

# --- Database (compose environment block overrides this for the container) ---
DATABASE_URL=postgres://gdptrader:gdptrader_password@postgres:5432/gdptraders
USE_IN_MEMORY_DB=false

# --- Automatic investment accruals ---
# ACCRUAL_ENABLED gates the daily accrual SCHEDULER. Deploy with it false,
# verify a dry run on staging, then set it to exactly `true` on the cutover date.
# Any other value (including unset) leaves the scheduler OFF.
ACCRUAL_ENABLED=false

# First date the AUTOMATED engine may pay. Every business day before this date
# was credited manually and is never created, recalculated, modified, reversed
# or credited by the scheduler. If it falls on a weekend, the first automated
# accrual is the next business day.
ACCRUAL_START_DATE=2026-09-18

# --- Card payments (Stripe) ---
# Leave empty to run deposits in MOCK mode (simulated, not charged).
STRIPE_SECRET_KEY=

# --- Email delivery (Resend) ---
# API key for transactional / verification emails. If left empty, the backend
# boots but verification emails are skipped and the link is logged to console.
RESEND_API_KEY=

# --- Constant custodial crypto wallet addresses for card-purchased deposits ---
DEPOSIT_WALLET_USDT=TUc2wxZTmfseu42idSDdhKDT35eyUiWwwp
DEPOSIT_WALLET_BTC=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
DEPOSIT_WALLET_ETH=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
