PORT=8000
JWT_SECRET=63ml9pvq4g0jit2hrceyzoknxds8u15waf7b
JWT_EXPIRES_IN=1h
NODE_ENV=development

# Database (PostgreSQL in production; in-memory store used by default)
DATABASE_URL=postgres://gdptrader:password@localhost:5432/gdptraders

USE_IN_MEMORY_DB=true

# Automatic daily accrual scheduler — opt-in.
# Accruals start automatically only when BOTH are true at boot:
#   1. PostgreSQL is active (ACCRUAL_ENABLED and daily accrual are PostgreSQL-only;
#      in-memory DB does not run the scheduler).
#   2. ACCRUAL_ENABLED=true (defaults to false; explicit opt-in).
# First eligible automated accrual date is ACCRUAL_START_DATE = 2026-09-18
# (a UTC Friday, business day). Earlier business days were manually credited
# and are permanently out of scope; each investment's deposit day itself pays
# nothing — accrual for a given client begins the next business day after deposit.
ACCRUAL_ENABLED=true
ACCRUAL_START_DATE=2026-09-18

# Constant custodial crypto wallet addresses that deposits are delivered to
# (updated per live addresses). USDT supports TRC-20 and BEP-20.
DEPOSIT_WALLET_USDT_TRC20=TUc2wxZTmfseu42idSDdhKDT35eyUiWwwp
DEPOSIT_WALLET_USDT_BEP20=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
DEPOSIT_WALLET_BTC=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
DEPOSIT_WALLET_ETH=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
