# GDPTraders backend environment example
# Copy to .env and fill in real values.

PORT=8000
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1h
NODE_ENV=development

# Database (PostgreSQL in production; in-memory store used by default)
DATABASE_URL=postgres://gdptrader:password@localhost:5432/gdptraders
USE_IN_MEMORY_DB=true

# Automatic investment accruals
# ACCRUAL_ENABLED: opt-in switch for the daily accrual scheduler. Only the exact
# string "true" enables it — deploy with it off, verify on staging, then turn it
# on deliberately for the cutover date.
ACCRUAL_ENABLED=false
# ACCRUAL_START_DATE: first date AUTOMATED accruals may pay (business days only).
# Everything before it was handled manually and is never credited by the engine.
ACCRUAL_START_DATE=2026-09-18

# Card payments (Stripe)
# When unset, the deposit flow runs in MOCK mode — payments are simulated and
# NOT charged. Set your Stripe secret key to enable real card deposits.
STRIPE_SECRET_KEY=

# Constant custodial crypto wallet addresses that deposits are delivered to.
# USDT supports two networks (TRC-20 on Tron and BEP-20 on BNB Smart Chain);
# BTC and ETH each use a single network.
DEPOSIT_WALLET_USDT_TRC20=TUc2wxZTmfseu42idSDdhKDT35eyUiWwwp
DEPOSIT_WALLET_USDT_BEP20=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
DEPOSIT_WALLET_BTC=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3
DEPOSIT_WALLET_ETH=0x69276bb6ccd6927ac2623a6b18601ce2d48efda3